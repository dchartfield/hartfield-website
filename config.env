# Hartfield Technologies site settings.
# deploy.sh replaces each {{NAME}} placeholder in site/*.html with these values.
# This repo is PUBLIC: everything in this file is visible on GitHub.
# Do not put your street address or phone number here. Twilio needs those
# only on its verification form, not on the website.

LEGAL_NAME="Hartfield Technologies LLC"
STATE_OF_FORMATION="TODO: state, e.g. Texas"
EMAIL="contact@hartfieldtechnologies.com"
DOMAIN="hartfieldtechnologies.com"
EFFECTIVE_DATE="November 24, 2026"

# Where to deploy
S3_BUCKET="hartfieldtechnologies.com"
S3_PREFIX=""                 # optional folder inside the bucket, e.g. "site"
AWS_PROFILE=""               # optional; blank uses your default credentials
CLOUDFRONT_DISTRIBUTION_ID=""  # optional; set to invalidate the CDN cache after deploy
